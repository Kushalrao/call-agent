# --- secrets and local state -------------------------------------------------
# .env holds live Deepgram / Anthropic / ElevenLabs / LiveKit credentials. This
# repo is public; nothing in here may ever be committed. See .env.example.
.env
.env.*
!.env.example

# Dev login codes, and the SQLite database that holds user records.
dev_codes.json
*.db

# Per-call logs contain transcripts of what people actually said, and
# agent-audio-*.wav are recordings of real calls. Neither belongs in a repo.
logs/

# Generated by scripts/make_audio_fixtures.py — regenerate rather than commit.
tests/fixtures/audio/

# --- build and tooling ------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store

# --- iOS --------------------------------------------------------------------
build/
*.xcuserdatad/
xcuserdata/
DerivedData/
