# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# config.py is the ONLY thing that reads this file. Modules that call
# os.environ.get() directly will not see it — a trap this project hit three
# times (Deepgram, LiveKit, and the Watermelon extension path). Pass values
# explicitly from Settings instead.

AUTH_MODE=dev
JWT_SIGNING_KEY=change-me-to-something-long
DATABASE_URL=sqlite+aiosqlite:///./hands_free.db

# --- LiveKit (cloud.livekit.io -> project -> settings) ----------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- agent ------------------------------------------------------------------
# Must be true, or the control plane rings the call and the agent never joins.
# A control plane started before this flag changes keeps the old value.
DISPATCH_AGENT=true
AGENT_NAME=trip-copilot

# --- model providers --------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# A free-tier ElevenLabs key is refused *library* voices via the API (402), and
# scoped keys may lack speech_to_text. The voice below is one that works on free.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- spend ceilings (agent/budget.py) — refusals, not warnings --------------
LLM_ENABLED=true
LLM_MAX_CALLS_PER_CALL=150
LLM_MAX_USD_PER_CALL=0.50
LLM_MAX_USD_PER_DAY=10.00
# true = canned classifier, spends nothing. Use for development and replays.
LLM_OFFLINE=false

# --- flight search ----------------------------------------------------------
# Checkout of github.com/Kushalrao/chrome-flight-extension
WATERMELON_EXTENSION_DIR=/absolute/path/to/chrome-flight-extension

# --- observability ----------------------------------------------------------
LOG_DIR=logs
LOG_PRETTY=true
# Utterance text is dropped unless this is true. Keep it false outside dev.
LOG_TRANSCRIPTS=false
